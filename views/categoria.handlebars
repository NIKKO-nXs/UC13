<h1 class="text-center my-4">Adicionar Categoria</h1>
<div class="container" style="max-width: 80%; ">
    <form action="/categoria/add" method="POST" class="mb-3 mx-auto">
        <div class="form-group">
            <label for="nome">Nome:</label>
            <input type="text" class="form-control" name="nome" required>
        </div>
        <div class="form-group">      
            <label for="descriacao">Descrição:</label>      
            <textarea class="form-control" name="descriacao" rows="3"></textarea>    
            </div>
            <button type="submit" class="btn btn-primary mt-3">Salvar Categoria</button>