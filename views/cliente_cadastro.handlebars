<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="text-center mb-0">Cadastro de Cliente</h2>
                </div>
                <div class="card-body">
                        <div class="mb-3">
                            <label for="nome" class="form-label">
                                <i class="bi bi-person"></i> Nome
                            </label>
                            <input type="text" class="form-control" id="nome" name="nome" 
                                required placeholder="Digite o nome completo">
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="bi bi-envelope"></i> Email
                            </label>
                            <input type="email" class="form-control" id="email" name="email" 
                                required placeholder="exemplo@email.com">
                        </div>

                        <div class="mb-3">
                            <label for="endereco" class="form-label">
                                <i class="bi bi-house"></i> Endereço
                            </label>
                            <input type="text" class="form-control" id="endereco" name="endereco" 
                                required placeholder="Digite o endereço completo">
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Cadastrar Cliente
                            </button>
                            <a href="/cliente" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>